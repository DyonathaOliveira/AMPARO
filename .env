# ============================================================
# AMPARO — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Full connection URL — used by the API server and Drizzle ORM
DATABASE_URL=postgresql://amparo:amparo_secret@localhost:5432/amparo

# Individual values (used by docker-compose to configure the
# postgres container — must match the URL above)
POSTGRES_DB=amparo
POSTGRES_USER=amparo
POSTGRES_PASSWORD=amparo_secret

# ------------------------------------------------------------
# API Server
# ------------------------------------------------------------
# Port the Express server listens on
PORT=8080

# Environment: "development" or "production"
NODE_ENV=production

# Session secret — CHANGE THIS in production (min 32 random chars)
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# ------------------------------------------------------------
# Frontend (only needed for local dev, not Docker production)
# ------------------------------------------------------------
# Port for the Vite dev server
VITE_PORT=3000

# Base path (leave as "/" unless serving from a subdirectory)
BASE_PATH=/
