# ============================================================
# AMPARO — Frontend (React/Vite) Dockerfile
# Multi-stage build: deps → build → nginx serve
# ============================================================

# Stage 1: Base with pnpm
FROM node:24-slim AS base
RUN npm install -g pnpm@10 --ignore-scripts

# Stage 2: Install workspace dependencies
FROM base AS deps
WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./

COPY lib/api-spec/package.json          lib/api-spec/
COPY lib/api-client-react/package.json  lib/api-client-react/
COPY lib/api-zod/package.json           lib/api-zod/
COPY lib/db/package.json                lib/db/
COPY artifacts/amparo/package.json      artifacts/amparo/
COPY scripts/package.json               scripts/

RUN pnpm install --frozen-lockfile

# Stage 3: Build the Vite app
FROM deps AS builder
WORKDIR /app

COPY tsconfig.json tsconfig.base.json ./
COPY lib/ lib/
COPY artifacts/amparo/ artifacts/amparo/
COPY attached_assets/ attached_assets/

# Build using the standalone vite config (no Replit plugins, sensible defaults)
ENV PORT=3000
ENV BASE_PATH=/
ENV NODE_ENV=production

RUN pnpm --filter @workspace/amparo run build:standalone

# Stage 4: Serve with Nginx
FROM nginx:alpine AS runner

# Copy built assets
COPY --from=builder /app/artifacts/amparo/dist/public /usr/share/nginx/html

# Copy Nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
